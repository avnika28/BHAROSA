# GEMINI_API_KEY: Server-side Gemini API key (never exposed to browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYPAL SANDBOX CREDENTIALS (Server-side REST API v2 + JS SDK Client ID served via /api/health)
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="sb"
PAYPAL_CLIENT_SECRET="sandbox_secret_bharosa_escrow"
PAYPAL_WEBHOOK_ID="WH-SANDBOX-BHAROSA"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# Enable instant PayPal Sandbox checkout flow when custom credentials are not set
PAYPAL_ALLOW_MOCK="true"

# Persistent disk path on hosting (defaults to ./data when empty)
DATA_DIR=""

# Server port
PORT="3000"

# Application Base URL for Magic Links
APP_URL="http://localhost:3000"
