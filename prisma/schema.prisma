// Prisma schema for BHAROSA (SQLite)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                     String          @id @default(cuid())
  title                  String
  brief                  String
  clientName             String
  amountUsd              Float
  deadline               String
  step                   String          @default("PAY") // PAY | WORK | CHECK | DONE
  statusWord             String          @default("HELD") // WAITING | HELD | CHECKING | FIXES NEEDED | PAID | VOIDED
  freelancerKey          String          @unique
  clientKey              String          @unique
  paypalOrderId          String?
  paypalAuthorizationId  String?
  authorizationCreatedAt DateTime?
  paypalCaptureId        String?
  paidAmountUsd          Float?
  revisionRound          Int             @default(0)
  clientFixNote          String?
  checkCompletedAt       DateTime?
  freelancerDisputeNote  String?
  clientDisputeNote      String?
  disputeSummary         String?
  disputeSuggestedUsd    Float?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  checklist              ChecklistItem[]
  deliveries             Delivery[]
  events                 Event[]
}

model ChecklistItem {
  id               String  @id @default(cuid())
  projectId        String
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text             String
  isSubjective     Boolean @default(false)
  status           String  @default("PENDING") // PENDING | PASS | FAIL | ASK_HUMAN
  reason           String?
  clientDecision   String? // PASS | FAIL
}

model Delivery {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note        String?
  link        String?
  filesJson   String   // JSON array of uploaded file metadata & extracted text
  submittedAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eventType   String
  payloadJson String
  createdAt   DateTime @default(now())
}
